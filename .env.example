# Copy this file to .env and set real values.
#
#   cp .env.example .env
#
# .env is gitignored — never commit real credentials.

# Host port to reach the app on: http://localhost:<CLOCKER_PORT>
# Only the host side changes; the app still listens on 3000 in the container.
# Leave blank or delete the line to use the default, 8090.
CLOCKER_PORT=8090

# Set both to require a login. Leave both blank (or don't create .env at all)
# to run with no auth.
AUTH_USER=
AUTH_PASS=
